{
  "name": "home-memory-system",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Home Memory prototype with an iOS app shell.",
  "type": "module",
  "scripts": {
    "dev": "python3 server.py 4173",
    "assets:vision": "python3 scripts/download-vision-assets.py",
    "build:web": "node scripts/build-web.mjs",
    "check:web": "node scripts/check-js-syntax.mjs",
    "check:architecture": "node scripts/validate-architecture.mjs",
    "check:model": "node scripts/validate-runtime-model.mjs",
    "check:mobile-package": "node scripts/validate-mobile-package.mjs",
    "ios:sync": "npm run build:web && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "test:simulator": "npm run ios:run"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "heic2any": "^0.0.4",
    "onnxruntime-web": "^1.22.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@huggingface/transformers": "^3.7.2"
  }
}
